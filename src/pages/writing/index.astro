---
import Base from '../../layouts/Base.astro';
const posts = [
  {
    title: "My guardrail did nothing for weeks, and nothing I had written noticed",
    summary: "How a jailbreak filter silently failed, why a 10-message test missed it, and what a 340-message set showed.",
    href: "/writing/guardrail-that-did-nothing",
    date: "November 2026",
  },
  {
    title: "My planner made retrieval worse, and a paired test showed it",
    summary: "A query rewrite that felt like an improvement lowered hit@5 and MRR. Paired comparisons on 65 labelled questions showed why.",
    href: "/writing/kube-rag-planner",
    date: "November 2026",
  },
  {
    title: "I wrote 56 tests for my own API, and they found four bugs",
    summary: "A fallback crash, an error returned as an answer, leaked 500 responses, and a deployment config that set keys to the string \"false\".",
    href: "/writing/production-rag-1-tests",
    date: "November 2026",
  },
];
---
<Base title="Writing | Shashank Chikattimala">
  <h1>Writing</h1>
  <p class="lead">Notes from building production AI systems: what broke, what I measured, and what I'd do differently.</p>
  <ul class="timeline">
    {posts.map((p) => (
      <li>
        <h3><a href={p.href}>{p.title}</a></h3>
        <p class="meta">{p.date}</p>
        <p>{p.summary}</p>
      </li>
    ))}
  </ul>
</Base>
