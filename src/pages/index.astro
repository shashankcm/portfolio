---
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("projects"))
    .filter((p) => p.data.status !== "planned")
    .sort((a, b) => a.data.order - b.data.order);
const stack = [
    ["AI and agents", "LangGraph, LangChain, agentic RAG, FastAPI services"],
    ["Retrieval and data", "Qdrant, Chroma, pgvector, hybrid search (BM25 + dense), FlashRank reranking"],
    ["Safety and evaluation", "NeMo Guardrails, retrieval metrics with bootstrap intervals, LangSmith tracing"],
    ["Platform", "Docker, Kubernetes, Terraform, GitHub Actions, Azure DevOps"],
    ["Product engineering", "Python, TypeScript, FastAPI, Node.js, React, Next.js"],
    ["Planned (MLOps)", "vLLM, AWQ, GGUF, MLflow, Prometheus, Grafana"],
];
---

<Base title="Shashank Chikattimala | AI Engineer and Technical Lead">
    <section class="hero">
        <div class="term intro">
            <div class="term-bar"><i></i><i></i><i></i><span class="title">~/shashank: zsh</span></div>
            <div class="term-body">
                <p class="cmd"><span>~/shashank $</span> <b>whoami</b></p>
                <h1 class="out">Shashank Chikattimala</h1>
                <p class="statement out">
                    I build AI systems that are measured before they are trusted:
                    retrieval, guardrails and evaluation, with checks that run in CI.
                </p>
                <p class="cmd"><span>~/shashank $</span> <b>cat status.txt</b></p>
                <p class="out dim">
                    Charlotte, NC &middot; Open to AI engineering roles &middot;
                    Leads a front-end team at Lowe's
                </p>
                <p class="cmd"><span>~/shashank $</span> <span class="cursor" aria-hidden="true"></span></p>
            </div>
        </div>
        <div class="cta intro d2">
            <a class="btn primary" href="/projects">cd projects</a>
            <a class="btn" href="/resume.pdf" target="_blank" rel="noopener">open resume.pdf</a>
            <a class="btn" href="https://github.com/shashankcm">open github</a>
        </div>
    </section>

    <h2 class="sh">ls projects/</h2>
    <ul class="rows">
        {projects.map((p) => (
            <ProjectRow id={p.id} {...p.data} />
        ))}
    </ul>
    <p class="label" style="margin-top:1rem">
        Each project has a case study with the architecture, what is built, and
        the limits. Numbers are published only after they have been measured.
    </p>

    <h2 class="sh">cat stack.yaml</h2>
    <dl class="kv">
        {stack.map(([t, d]) => (
            <>
                <dt>{t}</dt>
                <dd>{d}</dd>
            </>
        ))}
    </dl>
</Base>
