---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).filter((p) => p.data.status !== 'planned').sort((a, b) => a.data.order - b.data.order);
const skills = [
  ['AI & agents', 'LangGraph, LlamaIndex, LangChain, agentic RAG, multi-agent routing'],
  ['Retrieval & data', 'Qdrant, Milvus, Redis, MongoDB, SQL, hybrid search'],
  ['Safety & evaluation', 'NeMo Guardrails, Ragas, TruLens, LangSmith'],
  ['LLM serving', 'vLLM, TensorRT-LLM, Triton, AWQ/GGUF quantization'],
  ['Platform', 'Docker, Kubernetes, Terraform, GitHub Actions, Azure DevOps'],
  ['Product engineering', 'Python, TypeScript, FastAPI, Node.js, React, Next.js'],
];
---
<Base title="Shashank Chikattimala | AI Engineer and Technical Lead">
  <section class="hero">
    <span class="eyebrow"><span class="dot"></span> Charlotte, NC &middot; open to AI engineering roles</span>
    <h1>I build <span class="grad">production AI systems</span> that fail loudly, not silently.</h1>
    <p class="lead">Senior Software Engineer at Lowe's, leading 8 engineers. I'm applying 15 years of shipping enterprise software to retrieval, agents, guardrails and LLM evaluation.</p>
    <div class="cta">
      <a class="btn primary" href="/projects">See my projects</a>
      <a class="btn" href="/resume.pdf" target="_blank" rel="noopener">Download resume</a>
      <a class="btn" href="https://github.com/shashankcm">GitHub</a>
    </div>
  </section>

  <section class="stats" aria-label="Highlights">
    <div class="stat"><b>15 yrs</b><span>shipping enterprise software</span></div>
    <div class="stat"><b>8</b><span>engineers led at Lowe's</span></div>
    <div class="stat"><b>&minus;30%</b><span>release cycle time</span></div>
    <div class="stat"><b>&minus;20%</b><span>production bugs</span></div>
  </section>

  <h2><small>Featured work</small>AI projects</h2>
  <div class="cards">
    {projects.map((p) => <ProjectCard id={p.id} {...p.data} />)}
  </div>
  <p class="lead" style="margin-top:1.2rem;font-size:.95rem">Each project has a case study with the architecture and what's built so far. More are on the way, and numbers are published only after I've run the evaluation.</p>

  <h2><small>Toolbox</small>What I work with</h2>
  <div class="skills">
    {skills.map(([t, d]) => <div class="skill"><h3>{t}</h3><p>{d}</p></div>)}
  </div>
</Base>
