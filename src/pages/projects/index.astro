---
import { getCollection } from "astro:content";
import ProjectRow from "../../components/ProjectRow.astro";
import Base from "../../layouts/Base.astro";
const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<Base title="Projects | Shashank Chikattimala">
    <h1>Projects</h1>
    <p class="lead">
        Each project has a case study: the problem, the architecture, the
        decisions, and the measured results.
    </p>
    <ul class="rows">
        {projects.map((p) => (
            <ProjectRow id={p.id} {...p.data} />
        ))}
    </ul>
</Base>
