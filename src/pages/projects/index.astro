---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import Base from "../../layouts/Base.astro";
const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<Base title="Projects | Shashank Chikattimala">
    <h1>Projects</h1>
    <p class="lead">
        Each project has a case study: problem, architecture, decisions and
        measured results.
    </p>
    <div class="cards">
        {projects.map((p) => (
            <ProjectCard id={p.id} {...p.data} />
        ))}
    </div>
</Base>
